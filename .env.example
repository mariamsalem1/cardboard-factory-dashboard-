# Copy to .env and fill with real values. Never commit .env.

# Auth mode: 'sql' (UID/PWD) or 'windows' (Trusted_Connection).
MILL_DB_AUTH_MODE=windows

MILL_DB_SERVER=localhost
MILL_DB_NAME=cardboard_plant

# Required only when MILL_DB_AUTH_MODE=sql.
MILL_DB_USER=sa
MILL_DB_PASSWORD=CHANGE_ME

MILL_DB_ENCRYPT=yes
MILL_DB_TRUST_CERT=yes

# Replay wall-clock interval (seconds)
MILL_REPLAY_SECONDS=60

# HTTP port (avoid 8000-8005; those are often taken by other mill/SCADA demos)
MILL_API_PORT=8787
